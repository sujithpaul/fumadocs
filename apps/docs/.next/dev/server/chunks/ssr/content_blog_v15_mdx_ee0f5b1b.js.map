export let structuredData = {
  "contents": [{
    "heading": "overview",
    "content": "The purpose of v15 is mainly to support Tailwind CSS v4.\nTailwind CSS v4 is a complete redesign of its API and internals, to fully adhere to the new CSS-first config style, a breaking change is required."
  }, {
    "heading": "overview",
    "content": "Fumadocs v15 has no other significant changes other than migrating the config to Tailwind CSS v4."
  }, {
    "heading": "breaking-changes",
    "content": "Before making the switch, upgrade your site to Tailwind CSS v4 following their upgrade guide.\nYou can remove the unused tailwind.config.js file and fully rely on the new CSS-first config."
  }, {
    "heading": "breaking-changes",
    "content": "Add @import to the presets exported by Fumadocs UI, and include the fumadocs-ui package in the source."
  }, {
    "heading": "breaking-changes",
    "content": "Since v15, you will no longer pass options in JavaScript to customise plugins.\nInstead, you can use the new alternatives in Tailwind CSS v4."
  }, {
    "heading": "addglobalcolors-true",
    "content": "Forward the colors again:"
  }, {
    "heading": "css-variables",
    "content": "Fumadocs no longer use --fd-<color> like --fd-primary: 0 0% 0% for colors, it directly defines and uses colors in @theme.\nInstead of the previous format, it uses hsl():"
  }, {
    "heading": "steps",
    "content": "Previous Tailwind CSS utilities like steps & step are renamed to fd-steps and fd-step to avoid conflicts."
  }, {
    "heading": "typography",
    "content": "Typography utilities including prose, prose-* modifiers will continue to work. Please report problems if they are no longer working or have unexpected change in behaviours."
  }, {
    "heading": "improvements",
    "content": "v15 also includes some minor improvements to the UI and OpenAPI integration."
  }, {
    "heading": "code-block-tabs",
    "content": "In the past, you needed to write the <Tabs /> manually when separating code blocks into tabs."
  }, {
    "heading": "code-block-tabs",
    "content": "Now you can do:"
  }, {
    "heading": "code-block-tabs",
    "content": "Note that the previous usage still works for those who want to customise or pass props to the <Tabs /> component."
  }, {
    "heading": "reversed-items-in-metajson",
    "content": "The rest item ... in the pages property of meta.json now supports reversed order:"
  }, {
    "heading": "openapi-playground",
    "content": "v15 improves the playground UI (inspired by the minimalism of Scalar), and brought Scalar API Client support to Fumadocs OpenAPI."
  }, {
    "heading": "openapi-playground",
    "content": "You can enable the Scalar API Client using useScalar option in createOpenAPI():"
  }, {
    "heading": "openapi-playground",
    "content": "And install & configure their @scalar/api-client-react:"
  }, {
    "heading": "openapi-playground",
    "content": "Be careful that you must configure Tailwind CSS first, using the pre-built stylesheet of Fumadocs\nUI will conflict with their style.css because both libraries use Tailwind CSS for styling."
  }, {
    "heading": "future-plans",
    "content": "This update should be a simple migration for most developers updating to Tailwind CSS v4."
  }, {
    "heading": "future-plans",
    "content": "In the future, we also want to make further improvements to Fumadocs MDX:"
  }, {
    "heading": "future-plans",
    "content": "remove transform API - you can easily do the same with .map() on runtime like:"
  }, {
    "heading": "future-plans",
    "content": "remove Manifest API - it was designed to export search indexes, but now it's recommended to implement using route handlers."
  }, {
    "heading": "future-plans",
    "content": "Mention more about our MDX Remote package, it will be the primary solution to handle large docs sites with performance needs that bundlers couldn't do, including lazy compilation of MDX files."
  }],
  "headings": [{
