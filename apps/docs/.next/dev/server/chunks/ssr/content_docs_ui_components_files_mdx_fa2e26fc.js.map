export let _markdown = "\n\n<Installation name=\"files\" />\n\nUsage [#usage]\n\n<FeedbackBlock id=\"cf549e8693ae4c45\" body=\"Wrap file components in Files, you can use it in your MDX content, or as a normal React.js component.\">\n  Wrap file components in `Files`, you can use it in your MDX content, or as a normal React.js component.\n</FeedbackBlock>\n\n```mdx title=\"content.mdx\"\nimport { File, Folder, Files } from 'fumadocs-ui/components/files';\n\n<Files>\n  <Folder name=\"app\" defaultOpen>\n    <File name=\"layout.tsx\" />\n    <File name=\"page.tsx\" />\n    <File name=\"global.css\" />\n  </Folder>\n  <Folder name=\"components\">\n    <File name=\"button.tsx\" />\n    <File name=\"tabs.tsx\" />\n    <File name=\"dialog.tsx\" />\n  </Folder>\n  <File name=\"package.json\" />\n</Files>\n```\n\nFile [#file]\n\n<TypeTable\n  type={{\n  \"name\": \"FileProps\",\n  \"description\": \"\",\n  \"entries\": [\n    {\n      \"name\": \"name\",\n      \"description\": \"\",\n      \"tags\": [],\n      \"type\": \"string\",\n      \"simplifiedType\": \"string\",\n      \"required\": true,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"icon\",\n      \"description\": \"\",\n      \"tags\": [],\n      \"type\": \"ReactNode\",\n      \"simplifiedType\": \"ReactNode\",\n      \"required\": false,\n      \"deprecated\": false\n    }\n  ]\n}}\n/>\n\nFolder [#folder]\n\n<TypeTable\n  type={{\n  \"name\": \"FolderProps\",\n  \"description\": \"\",\n  \"entries\": [\n    {\n      \"name\": \"name\",\n      \"description\": \"\",\n      \"tags\": [],\n      \"type\": \"string\",\n      \"simplifiedType\": \"string\",\n      \"required\": true,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"disabled\",\n      \"description\": \"\",\n      \"tags\": [],\n      \"type\": \"boolean | undefined\",\n      \"simplifiedType\": \"boolean\",\n      \"required\": false,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"defaultOpen\",\n      \"description\": \"Open folder by default\",\n      \"tags\": [\n        {\n          \"name\": \"defaultValue\",\n          \"text\": \"false\"\n        }\n      ],\n      \"type\": \"boolean | undefined\",\n      \"simplifiedType\": \"boolean\",\n      \"required\": false,\n      \"deprecated\": false\n    }\n  ]\n}}\n/>\n\nRemark Plugin [#remark-plugin]\n\n<FeedbackBlock id=\"cb3cf5c5110ab17c\" body=\"You can enable remark-mdx-files for additional feature & syntax.\">\n  You can enable [`remark-mdx-files`](/docs/headless/mdx/remark-mdx-files) for additional feature & syntax.\n</FeedbackBlock>\n\n```tsx title=\"source.config.ts (Fumadocs MDX)\"\nimport { remarkMdxFiles } from 'fumadocs-core/mdx-plugins/remark-mdx-files';\nimport { defineConfig } from 'fumadocs-mdx/config';\n\nexport default defineConfig({\n  mdxOptions: {\n    // [!code ++]\n    remarkPlugins: [remarkMdxFiles],\n  },\n});\n```\n\nCodeBlock Syntax [#codeblock-syntax]\n\n<FeedbackBlock id=\"0764e7e30a2e6ed8\" body=\"It will convert files codeblocks into <Files /> component, like:\">\n  It will convert `files` codeblocks into `<Files />` component, like:\n</FeedbackBlock>\n\n````md title=\"content.md\"\n```files\nproject\n├── src\n│   ├── index.js\n│   └── utils\n│       └── helper.js\n├── package.json\n```\n````\n\n<auto-files> [#auto-files]\n\n<FeedbackBlock id=\"d46f21a7155be76f\" body=\"Generate <Files /> component from glob.\">\n  Generate `<Files />` component from glob.\n</FeedbackBlock>\n\n```mdx title=\"content.mdx\"\n<auto-files dir=\"./my-dir\" pattern=\"**/*.{ts,tsx}\" />\n\n<auto-files dir=\"./my-dir\" pattern=\"**/*.{ts,tsx}\" defaultOpenAll />\n```\n";
