export let structuredData = {
  "contents": [{
    "heading": "why",
    "content": "Taking some inspirations from Shadcn UI, I decided to make Fumadocs easier to use, with more APIs that simplify the design."
  }, {
    "heading": "why",
    "content": "This is a large update."
  }, {
    "heading": "fumadocs-cli",
    "content": "Clone Fumadocs UI components to your workspace and modify them."
  }, {
    "heading": "fumadocs-cli",
    "content": "See docs for details."
  }, {
    "heading": "sidebar-tabs",
    "content": "Previously, multiple page tree is implemented with Fumadocs UI RootToggle component.\nYou have to add it to the sidebar banner which isn't as intuitive as other APIs."
  }, {
    "heading": "sidebar-tabs",
    "content": "With Sidebar Tabs, by creating a root folder, Fumadocs will immediately add a tabs component to the sidebar."
  }, {
    "heading": "orama",
    "content": "We migrated the built-in search from Flexsearch to Orama, the same search engine that powers the Node.js docs site.\nIt is open source, and also have their Cloud integration."
  }, {
    "heading": "orama",
    "content": "No changes required.\nYou can use our new createFromSource API to create the route handler, which offers i18n support without any configurations."
  }, {
    "heading": "orama",
    "content": "In favour of this, the new search client of Fumadocs is introduced with support for different API clients.\nThis includes Algolia, Orama (static and dynamic with route handlers)."
  }, {
    "heading": "orama",
    "content": "See Search API."
  }, {
    "heading": "static-search",
    "content": "For sites with static export, you cannot use route handlers.\nWe now support client-side search using search indexes generated during build time."
  }, {
    "heading": "static-search",
    "content": "See Static Search."
  }, {
    "heading": "less-dependencies",
    "content": "I'm always working to reduce the dependencies required for Fumadocs, that is one reason why we separated Fumadocs into different packages."
  }, {
    "heading": "less-dependencies",
    "content": "Fumadocs UI now bundles icons from lucide-react, for Next.js apps that is not using Lucide, they can avoid downloading the entire icon library."
  }, {
    "heading": "less-dependencies",
    "content": "And swr is no longer used for search client, we implemented a light useQuery hook with extra care on React performance optimization."
  }, {
    "heading": "new-metadata-image-api",
    "content": "To improve code organization, we made a Metadata Image API on Fumadocs Core.\nIt is a tiny wrapper over Next.js Metadata API, composes seamlessly with Source API."
  }, {
    "heading": "new-metadata-image-api",
    "content": "In favour of this, the getImageMeta function from fumadocs-ui/og has been removed."
  }, {
    "heading": "shorthands",
    "content": "As you may notice, we introduced more abstractions to reduce the setup steps required for enabling some features.\nIt is also required for the code generator from Fumadocs CLI to work."
  }, {
    "heading": "shorthands",
    "content": "Like the generateParams function, it enables zero-configuration i18n support for Next.js generateStaticParams."
  }, {
    "heading": "better-card-component",
    "content": "Fumadocs UI Card can now support usage without href.\nYou can pass children as React node, Typography styles will be applied correctly."
  }, {
    "heading": "better-category-component",
    "content": "The original DocsCategory component was copied from our official docs, which is a very simple implementation that doesn't take page tree into account."
  }, {
    "heading": "better-category-component",
    "content": "Now it accepts the source object via from prop."
  }, {
    "heading": "better-category-component",
    "content": "By default, it takes the locale property from page to find the corresponding page tree to traverse.\nYou can also force a page tree."
  }, {
    "heading": "openapi-tag-display-name",
    "content": "Change the display name with x-displayName."
  }, {
    "heading": "better-typescript-docs-automation",
    "content": "The AutoTypeTable component now supports a type prop, you can use TypeScript inside the field:"
  }, {
    "heading": "better-typescript-docs-automation",
    "content": "And code highlighting in typedoc is also supported with Shiki."
  }, {
    "heading": "better-typescript-docs-automation",
    "content": "We highly recommend to use createTypeTable instead of importing the component in MDX files, this allows a single instance of TypeScript Compiler API to be shared.\nSee Auto Type Table."
  }, {
    "heading": "nextjs-15",
    "content": "Fumadocs v14 is compatible with Next.js 15, supporting sync and async usages of dynamic APIs."
  }, {
    "heading": "nextjs-15",
    "content": "type: info"
  }, {
    "heading": "nextjs-15",
    "content": "title: Backward compatible"
  }, {
    "heading": "nextjs-15",
    "content": "Next.js 14 is also supported, notice that guides/tutorials in the docs are mainly for Next.js 15."
  }, {
    "heading": "navbar-links",
    "content": "The navigation menu on Home layout is redesigned, with better animation and flexibility."
  }, {
    "heading": "navbar-links",
    "content": "See the new API."
  }, {
    "heading": "link-styles",
    "content": "You can escape Tailwind CSS Typography styles for the a tag with data-card attribute."
  }, {
    "heading": "disable-theme-switch",
    "content": "You can disable the default theme switcher with disableThemeSwitch on layouts."
  }, {
    "heading": "refactor-imports",
    "content": "Previous"
  }, {
    "heading": "refactor-imports",
    "content": "New Import Path"
  }, {
    "heading": "twoslash-ui",
    "content": "We moved Twoslash UI components to fumadocs-twoslash.\nThis isolates some logic from Fumadocs UI, allowing a better code organization."
  }, {
    "heading": "twoslash-ui",
    "content": "Import the CSS styles and Popup component differently."
  }, {
    "heading": "remove-deprecated-apis",
    "content": "The previous createI18nSearchAPIExperimental is now renamed to createI18nSearchAPI.\nIt takes the i18n config instead of scattering the options everywhere."
  }, {
    "heading": "remove-deprecated-apis",
    "content": "The types from fumadocs-core/search/shared is moved to fumadocs-core/server."
  }],
