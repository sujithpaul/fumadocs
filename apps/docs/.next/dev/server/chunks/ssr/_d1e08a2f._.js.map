import {Fragment as _Fragment, jsx as _jsx, jsxs as _jsxs} from "react/jsx-runtime";
export let _markdown = "\n\n\n\n\n\n\n\n<FeedbackBlock id=\"5f8e28d9774e8149\" body=\"A compact version of <DocsLayout />.\">\n  A compact version of [`<DocsLayout />`](/docs/ui/layouts/docs).\n</FeedbackBlock>\n\n<img alt=\"Notebook\" src={__img0} placeholder=\"blur\" />\n\n<Customisation />\n\nUsage [#usage]\n\n<FeedbackBlock id=\"d42f827490daa532\" body=\"Enable the notebook layout with fumadocs-ui/layouts/notebook.\">\n  Enable the notebook layout with `fumadocs-ui/layouts/notebook`.\n</FeedbackBlock>\n\n```tsx title=\"layout.tsx\"\nimport { DocsLayout } from 'fumadocs-ui/layouts/notebook'; // [!code highlight]\nimport { baseOptions } from '@/lib/layout.shared';\nimport { source } from '@/lib/source';\nimport type { ReactNode } from 'react';\n\nexport default function Layout({ children }: { children: ReactNode }) {\n  return (\n    <DocsLayout {...baseOptions()} tree={source.getPageTree()}>\n      {children}\n    </DocsLayout>\n  );\n}\n```\n\nConfigurations [#configurations]\n\n<FeedbackBlock id=\"7a1042fbf15e353c\" body=\"The options are inherited from Docs Layout, with minor differences:\">\n  The options are inherited from [Docs Layout](/docs/ui/layouts/docs), with minor differences:\n</FeedbackBlock>\n\n<FeedbackBlock id=\"b9e8af449a608049\" body=\"sidebar/navbar cannot be replaced, Notebook layout is more opinionated than the default one.additional options (see below).\">\n  * sidebar/navbar cannot be replaced, Notebook layout is more opinionated than the default one.\n  * additional options (see below).\n</FeedbackBlock>\n\nTab Mode [#tab-mode]\n\n<FeedbackBlock id=\"05467ae1fdd181b7\" body=\"Configure the style of sidebar tabs.\">\n  Configure the style of sidebar tabs.\n</FeedbackBlock>\n\n<img alt=\"Notebook\" src={__img1} placeholder=\"blur\" />\n\n```tsx title=\"layout.tsx\"\nimport { DocsLayout } from 'fumadocs-ui/layouts/notebook';\nimport { baseOptions } from '@/lib/layout.shared';\nimport { source } from '@/lib/source';\nimport type { ReactNode } from 'react';\n\nexport default function Layout({ children }: { children: ReactNode }) {\n  return (\n    <DocsLayout\n      {...baseOptions()}\n      tabMode=\"navbar\" // [!code ++]\n      tree={source.getPageTree()}\n    >\n      {children}\n    </DocsLayout>\n  );\n}\n```\n\nNav Mode [#nav-mode]\n\n<FeedbackBlock id=\"c1ad71ca04f6b44f\" body=\"Configure the style of navbar.\">\n  Configure the style of navbar.\n</FeedbackBlock>\n\n<img alt=\"Notebook\" src={__img2} placeholder=\"blur\" />\n\n```tsx title=\"layout.tsx\"\nimport { DocsLayout } from 'fumadocs-ui/layouts/notebook';\nimport { baseOptions } from '@/lib/layout.shared';\nimport { source } from '@/lib/source';\nimport type { ReactNode } from 'react';\n\nexport default function Layout({ children }: { children: ReactNode }) {\n  const { nav, ...base } = baseOptions();\n\n  return (\n    <DocsLayout\n      {...base}\n      nav={{ ...nav, mode: 'top' }} // [!code ++]\n      tree={source.getPageTree()}\n    >\n      {children}\n    </DocsLayout>\n  );\n}\n```\n";
