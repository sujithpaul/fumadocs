    "content": "import { useDocsSearch } from 'fumadocs-core/search/client';\n\nconst client = useDocsSearch({\n  type: 'fetch',\n  tag: '<value>', // [!code ++]\n});"
  }, {
    "heading": "static-export",
    "content": "To support usage with static site, use staticGET from search server and make the route static or pre-rendered."
  }, {
    "heading": "static-export",
    "content": "import { source } from '@/lib/source';\nimport { createFromSource } from 'fumadocs-core/search/server';\n\n// statically cached [!code highlight:2]\nexport const revalidate = false;\nexport const { staticGET: GET } = createFromSource(source);"
  }, {
    "heading": "static-export",
    "content": "// make sure this route is pre-rendered in `react-router.config.ts`.\nexport async function loader() {\n  // [!code highlight]\n  return server.staticGET();\n}"
  }, {
    "heading": "static-export",
    "content": "import { createFileRoute } from '@tanstack/react-router';\n\nexport const Route = createFileRoute('/api/search')({\n  server: {\n    handlers: {\n      // [!code highlight]\n      GET: async () => server.staticGET(),\n    },\n  },\n});"
  }, {
    "heading": "static-export",
    "content": "import { tanstackStart } from '@tanstack/react-start/plugin/vite';\nimport { defineConfig } from 'vite';\n\nexport default defineConfig({\n  plugins: [\n    tanstackStart({\n      prerender: {\n        enabled: true,\n      },\n      // [!code ++] pre-render the index file\n      pages: [{ path: '/api/search' }],\n    }),\n  ],\n});"
  }, {
    "heading": "static-export",
    "content": "import { source } from '@/lib/source';\nimport { createFromSource } from 'fumadocs-core/search/server';\n\n// [!code highlight]\nexport const { staticGET: GET } = createFromSource(source);\n\n// statically cached [!code highlight:3]\nexport const getConfig = async () => ({\n  render: 'static',\n});"
  }, {
    "heading": "static-export",
    "content": "staticGET is also available on createSearchAPI."
  }, {
    "heading": "static-export",
    "content": "and update your search clients:"
  }, {
    "heading": "static-export",
    "content": "Fumadocs UI: use static client on Search UI."
  }, {
    "heading": "static-export",
    "content": "Search Client: use static instead of fetch."
  }, {
    "heading": "static-export",
    "content": "import { useDocsSearch } from 'fumadocs-core/search/client';\n\nconst client = useDocsSearch({\n  type: 'static',\n});"
  }, {
    "heading": "static-export",
    "content": "type: {\n  \"name\": \"$Fumadocs\",\n  \"description\": \"\",\n  \"entries\": [\n    {\n      \"name\": \"type\",\n      \"description\": \"\",\n      \"tags\": [],\n      \"type\": \"\\\"static\\\"\",\n      \"simplifiedType\": \"\\\"static\\\"\",\n      \"required\": true,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"from\",\n      \"description\": \"Where to download exported search indexes (URL)\",\n      \"tags\": [\n        {\n          \"name\": \"defaultValue\",\n          \"text\": \"'/api/search'\"\n        }\n      ],\n      \"type\": \"string | undefined\",\n      \"simplifiedType\": \"string\",\n      \"required\": false,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"initOrama\",\n      \"description\": \"\",\n      \"tags\": [],\n      \"type\": \"((locale?: string) => AnyOrama | Promise<AnyOrama>) | undefined\",\n      \"simplifiedType\": \"function\",\n      \"required\": false,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"tag\",\n      \"description\": \"Filter results with specific tag(s).\",\n      \"tags\": [],\n      \"type\": \"string | string[] | undefined\",\n      \"simplifiedType\": \"array | string\",\n      \"required\": false,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"locale\",\n      \"description\": \"Filter by locale (unsupported at the moment)\",\n      \"tags\": [],\n      \"type\": \"string | undefined\",\n      \"simplifiedType\": \"string\",\n      \"required\": false,\n      \"deprecated\": false\n    }\n  ]\n}"
  }, {
    "heading": "static-export",
    "content": "type: warn"
  }, {
    "heading": "static-export",
    "content": "title: Be Careful"
  }, {
    "heading": "static-export",
    "content": "Static Search requires clients to download the exported search indexes.\nFor large docs sites, it can be expensive."
  }, {
    "heading": "static-export",
    "content": "You should use cloud solutions like Orama Cloud or Algolia for these cases."
  }, {
    "heading": "internationalization",
    "content": "Make sure your language is on the Orama Supported Languages list."
  }, {
    "heading": "internationalization",
    "content": "import { source } from '@/lib/source';\nimport { createFromSource } from 'fumadocs-core/search/server';\n\nconst server = createFromSource(source, {\n  localeMap: {\n    // [locale]: Orama options [!code ++:2]\n    ru: { language: 'russian' },\n    en: { language: 'english' },\n  },\n});"
  }, {
    "heading": "internationalization",
    "content": "import { source } from '@/lib/source';\nimport { createI18nSearchAPI } from 'fumadocs-core/search/server';\nimport { i18n } from '@/lib/i18n';\n\nconst server = createI18nSearchAPI('advanced', {\n  i18n, // [!code ++]\n  indexes: source.getLanguages().flatMap(({ language, pages }) =>\n    pages.map((page) => ({\n      title: page.data.title,\n      description: page.data.description,\n      structuredData: page.data.structuredData,\n      id: page.url,\n      url: page.url,\n      locale: language === 'ru' ? 'russian' : 'english', // [!code ++]\n    })),\n  ),\n});"
  }, {
    "heading": "internationalization",
    "content": "For Static Mode, you should configure from client-side instead:"
  }, {
    "heading": "internationalization",
    "content": "import { useDocsSearch } from 'fumadocs-core/search/client';\nimport { create } from '@orama/orama';\n\nfunction initOrama(locale?: string) {\n  return create({\n    schema: { _: 'string' },\n    // [!code ++]\n    language: locale === 'ru' ? 'russian' : 'english',\n  });\n}\n\nfunction Search() {\n  const client = useDocsSearch({\n    type: 'static',\n    initOrama,\n  });\n\n  // ...\n}"
  }, {
    "heading": "special-languages",
    "content": "Chinese and Japanese require additional configurations:"
  }, {
    "heading": "special-languages",
    "content": "npm i @orama/tokenizers"
  }, {
    "heading": "special-languages",
    "content": "pnpm add @orama/tokenizers"
  }, {
    "heading": "special-languages",
    "content": "yarn add @orama/tokenizers"
  }, {
    "heading": "special-languages",
    "content": "bun add @orama/tokenizers"
  }, {
    "heading": "special-languages",
    "content": "import { useDocsSearch } from 'fumadocs-core/search/client';\nimport { createTokenizer } from '@orama/tokenizers/mandarin';\nimport { create } from '@orama/orama';\n\n// [!code focus:8]\nfunction initOrama(locale?: string) {\n  return create({\n    schema: { _: 'string' },\n    components: {\n      tokenizer: locale === 'cn' ? createTokenizer() : undefined,\n    },\n  });\n}\n\nfunction Search() {\n  const client = useDocsSearch({\n    type: 'static',\n    initOrama,\n  });\n  // ...\n}"
  }, {
    "heading": "special-languages",
    "content": "and update your search clients:"
  }, {
    "heading": "special-languages",
    "content": "Fumadocs UI: No changes needed, Fumadocs UI handles this when you have i18n configured correctly."
  }, {
    "heading": "special-languages",
    "content": "Search Client:\nAdd locale to the search client, this will only allow pages with specified locale to be searchable by the user."
  }, {
    "heading": "special-languages",
    "content": "import { useDocsSearch } from 'fumadocs-core/search/client';\n\nconst { search, setSearch, query } = useDocsSearch({\n  type: 'fetch',\n  locale: 'cn',\n});"
  }, {
    "heading": "headless",
    "content": "You can host the search server on other backend such as Express and Elysia."
  }, {
    "heading": "headless",
    "content": "import { initAdvancedSearch } from 'fumadocs-core/search/server';\n\nconst server = initAdvancedSearch({\n  // you still have to pass indexes\n});\n\nserver.search('query', {\n  // you can specify `locale` and `tag` here\n});"
  }],
