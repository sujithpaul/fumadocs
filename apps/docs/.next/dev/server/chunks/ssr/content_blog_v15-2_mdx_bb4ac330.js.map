export let frontmatter = {
  "title": "Fumadocs v15.2",
  "description": "From Next.js only to Next.js first.",
  "author": "Fuma Nama",
  "date": new Date(1743120000000)
};
export let lastModified = new Date(1747962302000);
export let structuredData = {
  "contents": [{
    "heading": "overview",
    "content": "Fumadocs 15.2 introduces a layer over fumadocs-core to extend support to other React frameworks, including React Router and Tanstack Start. Other frameworks can also be supported using the FrameworkProvider from fumadocs-core/framework/base."
  }, {
    "heading": "why",
    "content": "The main focus of Fumadocs is flexibility, I aim to support more frameworks as long as it doesn't change the fundamentals of Fumadocs, like the separation of core and UI package."
  }, {
    "heading": "why",
    "content": "The React.js ecosystem is a joy to work with, porting Fumadocs to other frameworks isn't as difficult as I thought.\nIt's also my goal to make it work not only for Next.js devs, but also everyone in the ecosystem who is using a SSR-compatible React framework."
  }, {
    "heading": "breaking-changes",
    "content": "This is a minor release, it shouldn't break any previous usages unless you're relying on the lower level APIs from fumadocs-core without fumadocs-ui."
  }, {
    "heading": "breaking-changes",
    "content": "Fumadocs Core now requires a FrameworkProvider. It's as simple as wrapping it with appropriate provider:"
  }, {
    "heading": "breaking-changes",
    "content": "If you're using Fumadocs UI, there's no need to change. RootProvider included it by default, and allows you to provide your own framework with:"
  }, {
    "heading": "breaking-changes",
    "content": "Please report issues if you find any public APIs are broken unexpectedly."
  }, {
    "heading": "compilation-time",
    "content": "15.2 also included some small performance improvements to Fumadocs, the time taken for Turbopack to start dev server and compile its first docs page is about 2-3 seconds."
  }, {
    "heading": "compilation-time",
    "content": "This change also potentially allows Fumadocs to run on Vite, production build of minimal React Router setup only takes around 4s on a Macbook."
  }, {
    "heading": "try-it-out",
    "content": "Upgrade from your existing Next.js docs:"
  }, {
    "heading": "try-it-out",
    "content": "If you want to try the React Router example:"
  }, {
    "heading": "future-plans",
    "content": "15.2 doesn't support Astro, and probably won't unless better React.js support is provided by Astro."
  }, {
    "heading": "future-plans",
    "content": "transition:persist is needed for Fumadocs UI layouts, however this will also affect its children (e.g. MDX content), causing page content to be persisted even after navigation."
  }, {
    "heading": "future-plans",
    "content": "React contexts cannot work across islands, this changes the usage of Fumadocs significantly and hence require a redesign of APIs."
  }, {
    "heading": "future-plans",
    "content": "Fumadocs will continue to be Next.js first, the docs won't be changed to generalize usages of other frameworks. Instead, a new docs site will be developed for other frameworks (planned)."
  }],
  "headings": [{
    "id": "overview",
    "content": "Overview"
  }, {
    "id": "why",
    "content": "Why?"
  }, {
    "id": "breaking-changes",
    "content": "Breaking Changes"
  }, {
    "id": "compilation-time",
