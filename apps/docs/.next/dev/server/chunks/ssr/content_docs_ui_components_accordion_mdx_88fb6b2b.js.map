"boolean\",\n      \"required\": false,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"type\",\n      \"description\": \"\",\n      \"tags\": [],\n      \"type\": \"\\\"single\\\" | \\\"multiple\\\"\",\n      \"simplifiedType\": \"\\\"multiple\\\" | \\\"single\\\"\",\n      \"required\": true,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"disabled\",\n      \"description\": \"Whether or not an accordion is disabled from user interaction.\",\n      \"tags\": [\n        {\n          \"name\": \"defaultValue\",\n          \"text\": \"false\"\n        }\n      ],\n      \"type\": \"boolean | undefined\",\n      \"simplifiedType\": \"boolean\",\n      \"required\": false,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"orientation\",\n      \"description\": \"The layout in which the Accordion operates.\",\n      \"tags\": [\n        {\n          \"name\": \"default\",\n          \"text\": \"vertical\"\n        }\n      ],\n      \"type\": \"\\\"horizontal\\\" | \\\"vertical\\\" | undefined\",\n      \"simplifiedType\": \"\\\"vertical\\\" | \\\"horizontal\\\"\",\n      \"required\": false,\n      \"deprecated\": false\n    }\n  ]\n}}\n/>\n\nAccordion [#accordion]\n\n<TypeTable\n  type={{\n  \"name\": \"AccordionProps\",\n  \"description\": \"\",\n  \"entries\": [\n    {\n      \"name\": \"asChild\",\n      \"description\": \"\",\n      \"tags\": [],\n      \"type\": \"boolean | undefined\",\n      \"simplifiedType\": \"boolean\",\n      \"required\": false,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"disabled\",\n      \"description\": \"Whether or not an accordion item is disabled from user interaction.\",\n      \"tags\": [\n        {\n          \"name\": \"defaultValue\",\n          \"text\": \"false\"\n        }\n      ],\n      \"type\": \"boolean | undefined\",\n      \"simplifiedType\": \"boolean\",\n      \"required\": false,\n      \"deprecated\": false\n    },\n    {\n      \"name\": \"value\",\n