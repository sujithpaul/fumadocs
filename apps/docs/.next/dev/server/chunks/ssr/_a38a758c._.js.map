export let frontmatter = {
  "title": "Fumadocs v16",
  "description": "Better framework support, better performance.",
  "author": "Fuma Nama",
  "date": new Date(1761091200000)
};
export let lastModified = new Date(1768040846000);
export let structuredData = {
  "contents": [{
    "heading": "overview",
    "content": "We are pleased to announce the release of Fumadocs v16, a significant update that introduces breaking changes designed to refine our API surface, improve compatibility with Vite frameworks, and boost overall performance."
  }, {
    "heading": "major-changes",
    "content": "Fumadocs 16 removed substantial amount of deprecated APIs accumulated since v15.2 Vite support."
  }, {
    "heading": "major-changes",
    "content": "Removal of the Sidebar API: The fumadocs-core/sidebar module has been deprecated and removed. For sidebar implementations, we recommend adopting pre-built solutions from Shadcn UI."
  }, {
    "heading": "major-changes",
    "content": "Restructuring of Server-Side Exports: Exports from fumadocs-core/server have been redistributed to more specialized modules:"
  }, {
    "heading": "major-changes",
    "content": "getGithubLastEdit -> fumadocs-core/content/github."
  }, {
    "heading": "major-changes",
    "content": "getTableOfContents -> fumadocs-core/content/toc."
  }, {
    "heading": "major-changes",
    "content": "PageTree and related utilities -> fumadocs-core/page-tree."
  }, {
    "heading": "major-changes",
    "content": "TOCItemType and TableOfContents -> fumadocs-core/toc."
  }, {
    "heading": "major-changes",
    "content": "removed createMetadataImage API, use Next.js Metadata API instead."
  }, {
    "heading": "major-changes",
    "content": "Default Switch to Shiki's JavaScript Regex Engine: To ensure seamless compatibility with environments like Cloudflare Workers, the JavaScript engine is now the default over the WASM-based Oniguruma. This change affects rehype-code (via the engine option) and fumadocs-core/highlight."
  }, {
    "heading": "major-changes",
    "content": "Minimum React.js Version Raised to 19.2.0: React 19.2 brings crucial performance improvements to Fumadocs UI."
  }, {
    "heading": "major-changes",
    "content": "Next.js Projects: Next.js projects using Fumadocs UI must use Next.js 16 or later, as Next.js uses its own canary channel for React.js."
  }, {
    "heading": "major-changes",
    "content": "fumadocs-ui/provider is removed:"
  }, {
    "heading": "major-changes",
    "content": "Use fumadocs-ui/provider/next for root provider."
  }, {
    "heading": "major-changes",
    "content": "Use individual exports for contexts from fumadocs-ui/contexts/*."
  }, {
    "heading": "major-changes",
    "content": "fumadocs-ui/page:"
  }, {
    "heading": "major-changes",
    "content": "Removed <DocsCategory />, use getPageTreePeers() instead:"
  }, {
    "heading": "major-changes",
    "content": "Removed the breadcrumbs.full option in <DocsPage />."
  }, {
    "heading": "major-changes",
    "content": "fumadocs-core/search/algolia: The document option is renamed to indexName."
  }, {
    "heading": "major-changes",
    "content": "fumadocs-core/search: Removed the deprecated createFromSource() signature in useSearch()."
  }, {
    "heading": "major-changes",
    "content": "fumadocs-core/highlight: Removed withPrerenderScript and loading options from useShiki(), use React Suspense API instead."
  }, {
    "heading": "major-changes",
    "content": "fumadocs-core/i18n: Removed createI18nMiddleware (import from fumadocs-core/i18n/middleware instead)."
  }, {
    "heading": "major-changes",
    "content": "fumadocs-core/source:"
  }, {
    "heading": "major-changes",
    "content": "Removed transformers, pageTree.attach* options in loader(): use Loader Plugin instead."
  }, {
    "heading": "major-changes",
    "content": "Removed the page.file property: use page.path instead."
  }, {
    "heading": "major-changes",
    "content": "Removed internal utilities FileInfo and parseFilePath: use PathUtils instead."
  }, {
    "heading": "major-changes",
    "content": "Migration to Orama Cloud's New SDK: The @orama/core package replaces the prior client. Update your synchronization code as follows:"
  }, {
    "heading": "major-changes",
    "content": "You can also continue to use the legacy Orama Cloud client:"
  }, {
    "heading": "major-changes",
    "content": "Refer to the Orama Cloud documentation for further details."
  }, {
    "heading": "styling-changes",
    "content": "Fumadocs UI has included some aggressive styling changes that you should know about."
  }, {
    "heading": "styling-changes",
    "content": "The default --fd-layout-width CSS variable is set to 1600px for optimal content scaling.\nYou can override it if needed."
  }, {
    "heading": "fumadocs-openapi-96",
    "content": "A redesigned schema UI emphasizes client-side rendering (CSR) for recursive components, reducing bundle sizes and enhancing performance in complex JSON schemas."
  }, {
    "heading": "fumadocs-openapi-96",
    "content": "Non-required fields now include a reset button, with support for content.showExampleInFields."
  }, {
    "heading": "whats-next",
    "content": "Fumadocs v16 is a new start for Fumadocs. We appreciate your feedback and contributions—please share your experiences on GitHub. Thank you for supporting Fumadocs :)"
  }],
  "headings": [{
    "id": "overview",
    "content": "Overview"
  }, {
    "id": "major-changes",
    "content": "Major Changes"
  }, {
    "id": "styling-changes",
