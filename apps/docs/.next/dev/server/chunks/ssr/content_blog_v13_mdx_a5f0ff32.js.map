export let structuredData = {
  "contents": [{
    "heading": "introduction",
    "content": "Fumadocs v13 has been released. It aims to fix the CSS pollution problem and remove deprecated APIs."
  }, {
    "heading": "better-code-blocks",
    "content": "Now supports keeping the original background generated by Shiki on CodeBlock component."
  }, {
    "heading": "callout",
    "content": "Callout is now a default MDX component, you can use it in MDX files without an import, or manually adding it to MDX components."
  }, {
    "heading": "new-headless-toc",
    "content": "The headless component of Table of Contents (TOC) now has a separate scroll container provider."
  }, {
    "heading": "new-headless-toc",
    "content": "The anchor provider can be placed anywhere."
  }, {
    "heading": "opt-out-of-container",
    "content": "Now supports disabling the default container styles of Tailwind CSS added by Fumadocs UI."
  }, {
    "heading": "admonition-syntax",
    "content": "In Docusaurus, there's an Admonition syntax."
  }, {
    "heading": "admonition-syntax",
    "content": "For people migrating from Docusaurus, you can enable the new remark plugin to support the Admonition syntax."
  }, {
    "heading": "admonition-syntax",
    "content": "See Remark Admonition."
  }, {
    "heading": "prefix-to-colors-animations-and-utilities",
    "content": "Previously, the Tailwind CSS plugin of Fumadocs UI added colors (including primary, secondary) which conflicted with Shadcn UI and other design systems.\nA fd- prefix is added to them to allow the flexibility to have a separated design system on docs."
  }, {
    "heading": "prefix-to-colors-animations-and-utilities",
    "content": "To use the Fumadocs UI colors on your primary app, enable the addGlobalColors option."
  }, {
    "heading": "prefix-to-colors-animations-and-utilities",
    "content": "This adds the colors without the fd- prefix."
  }, {
    "heading": "prefix-to-colors-animations-and-utilities",
    "content": "Or you can just reference them with the fd- prefix, like bg-fd-background."
  }, {
    "heading": "tailwind-css-plugin-esm-only",
    "content": "Since Tailwind CSS supports TypeScript configuration, it makes sense to migrate the entire plugin to ESM."
  }, {
    "heading": "tailwind-css-plugin-esm-only",
    "content": "Use ESM syntax in your configuration."
  }, {
    "heading": "remove-rollbutton-component",
    "content": "RollButton was introduced because there were no \"Table Of Contents\" on mobile viewports.\nNow users can use the TOC Popover to switch between headings, it is no longer a suitable design for Fumadocs UI."
  }, {
    "heading": "remove-rollbutton-component",
    "content": "You may copy the last implementation of RollButton."
  }, {
    "heading": "better-i18n",
    "content": "Now the I18nProvider component requires the locale prop instead of parsing it from pathname.\nThis fixed some bugs with the I18n middleware."
  }, {
    "heading": "better-i18n",
    "content": "We also changed the usage of translations to reduce extra translations loaded on the client side.\nYou have to pass the active translations directly."
  }, {
    "heading": "better-i18n",
    "content": "locales is passed as the available options on the Language Select component."
  }, {
    "heading": "code-block-usage",
    "content": "The previous usage was confusing, some props are passed directly to pre while some are not."
  }, {
    "heading": "code-block-usage",
    "content": "With v13, pass all props to the CodeBlock component.\nThis also includes class names, you may change your custom styles if necessary."
  }, {
    "heading": "remove-deprecated-apis",
    "content": "Remove deprecated fumadocs-ui/components/api components."
  }, {
    "heading": "remove-deprecated-apis",
    "content": "Replace secondary link items with icon link items."
  }, {
    "heading": "remove-deprecated-apis",
    "content": "Rename id prop on Tabs component to groupId."
  }, {
    "heading": "ui",
    "content": "Fixed empty folder animation problems caused by Radix UI."
