export let structuredData = {
  "contents": [{
    "heading": undefined,
    "content": "We are pleased to announce the release of Fumadocs 16.2, introducing a better layout system for Fumadocs UI."
  }, {
    "heading": "the-new-layout-system",
    "content": "Handling layouts in documentation frameworks can present significant challenges."
  }, {
    "heading": "the-new-layout-system",
    "content": "As a solution, Fumadocs UI implemented a Grid System that is composable, flexible, cohesive and predictable.\nSee the linked docs for more details."
  }, {
    "heading": "the-new-layout-system",
    "content": "In short, the layout consists of a grid container, and layout components using position: sticky:"
  }, {
    "heading": "the-new-layout-system",
    "content": "The container defines the offsets of each row, layout components can leverage them according to their grid area:"
  }, {
    "heading": "the-new-layout-system",
    "content": "Layout components are also responsible to declare their heights via CSS variables, allowing container to calculate the right row offsets."
  }, {
    "heading": "the-new-layout-system",
    "content": "For user-land customizations, we recommend the Fumadocs CLI customize command, or hooking the relevant grid areas like:"
  }, {
    "heading": "why-the-change",
    "content": "Previously, Fumadocs UI relied on position: fixed and mathematical computations (inspired by Vitepress). The older method often lacked composability and difficult for beginners to manage."
  }, {
    "heading": "why-the-change",
    "content": "The new system fixed most of the flaws, allowing easier visualizations, while reducing the complexity of previous solutions."
  }, {
    "heading": "breaking-changes",
    "content": "While Fumadocs 16.2 preserves compatibility in several areas, notably:"
  }, {
    "heading": "breaking-changes",
    "content": "The --fd-layout-width CSS variable continues to function as expected."
  }, {
    "heading": "breaking-changes",
    "content": "All ID and data attributes remain unchanged."
  }, {
    "heading": "breaking-changes",
    "content": "However, the shift to the new grid system may impact existing customizations, particularly those dependent on the prior fixed-position logic. We recommend reviewing your implementation carefully and testing thoroughly."
  }, {
    "heading": "no-longer-exposing-internal-components",
    "content": "Layout components such as Root Toggle, Language Toggle, and Theme Toggle are no longer directly exposed.\nThis decision enables Fumadocs UI to iterate these elements without introducing unexpected breaking changes to usage outside of API surfaces."
  }, {
    "heading": "no-longer-exposing-internal-components",
    "content": "Migration Steps: Override the relevant layout components with your own implementations, or utilize the Fumadocs CLI commands (add or customize) to install them locally."
  }, {
    "heading": "importing-page-layouts-by-type",
    "content": "The notebook layout is now isolated from default layout, including their page components."
  }, {
    "heading": "importing-page-layouts-by-type",
    "content": "Make sure to import the appropriate page layout based on your docs layout:"
  }, {
    "heading": "importing-page-layouts-by-type",
    "content": "Migration Steps: Update your imports accordingly. Although the default fumadocs-ui/page will redirect to the correct layout, we strongly advise explicit imports for clarity and future-proofing."
  }, {
    "heading": "removal-of-unused-styles",
    "content": "Styles related to the abandoned container utility, and --spacing-fd-container variable, have been dropped as they are no longer utilized."
  }, {
    "heading": "removal-of-unused-styles",
    "content": "Migration Steps: Remove references to these styles from your codebase."
  }, {
    "heading": "relocation-of-sidebar-context",
    "content": "The fumadocs-ui/contexts/sidebar module has been removed. Access the context via:"
  }, {
    "heading": "relocation-of-sidebar-context",
    "content": "Migration Steps: Update import paths, ensure the context is only accessed within <DocsLayout />."
  }, {
    "heading": "conclusion",
    "content": "Fumadocs 16.2 aims to offer greater flexibility for developers. Welcome to share your thoughts about the new design on GitHub Discussion!"
  }],
  "headings": [{
    "id": "the-new-layout-system",
    "content": "The New Layout System"
