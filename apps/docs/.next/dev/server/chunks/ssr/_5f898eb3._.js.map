export let structuredData = {
  "contents": [{
    "heading": "whats-new",
    "content": "Fumadocs v12 mainly aims to improve the UI, prioritizing content and reading experience."
  }, {
    "heading": "new-ui",
    "content": "After observing large docs sites like https://turbo.build, I found that the navbar took too much space on the screen, while it only contains links to Blog, Showcase, GitHub, etc.\nThey are not necessarily related to the docs, placing them at the top of our screen doesn't bring a better reading experience."
  }, {
    "heading": "new-ui",
    "content": "All these links are now moved to the sidebar, allowing a clean, minimal view of the docs."
  }, {
    "heading": "new-ui",
    "content": "I also noticed the docs start to look messy as your content grows. To ameliorate this, the sidebar now includes a border and background by default.\nThis helps readers to distinguish navigation elements and content easier."
  }, {
    "heading": "new-ui",
    "content": "The sidebar will always be placed at the left of the screen, having a bigger space on large viewports."
  }, {
    "heading": "new-ui",
    "content": "I believe the new UI still has room for improvement. Welcome to report UI issues, or leave feedback!"
  }, {
    "heading": "better-multi-page-trees",
    "content": "We supported multiple page trees at a very early version of Fumadocs. However, it lacks proper explanations and guides to configure it.\nIn the past, you needed to implement a navigation element to switch between page trees and mark the folder as a root folder."
  }, {
    "heading": "better-multi-page-trees",
    "content": "Now, you can use the <RootToggle /> component directly, and the docs has a better explanation of it."
  }, {
    "heading": "page-tree-post-processors",
    "content": "You can now attach properties to page trees easily with the Source API."
  }, {
    "heading": "improved-i18n-support",
    "content": "The language switch is now added to Docs Layout."
  }, {
    "heading": "improved-i18n-support",
    "content": "Note that <LanguageSelect /> component is now replaced by <LanguageToggle />, make sure to remove references to the old component."
  }, {
    "heading": "ui",
    "content": "Remove deprecated option enableThemeProvider from Root Provider. Use theme.enabled instead."
  }, {
    "heading": "core",
    "content": "Remove deprecated option minWidth from Sidebar component. Use blockScrollingWidth instead"
  }, {
    "heading": "ui-1",
    "content": "Fix problems with twoslash codeblocks"
  }, {
    "heading": "ui-1",
    "content": "Apply typography styles to headings"
  }, {
    "heading": "ui-1",
    "content": "Support translation for theme label"
  }, {
    "heading": "openapi",
    "content": "Fix nullable types cannot be detected"
  }, {
    "heading": "core-1",
    "content": "Remark Headings: Support code syntax in headings"
  }, {
    "heading": "create-fumadocs-app",
    "content": "Add layout.config.tsx file for sharing layout options"
