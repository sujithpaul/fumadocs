export let structuredData = {
  "contents": [{
    "heading": "mdx-componenttsx",
    "content": "Sometimes there are questions raised by beginners confused about where to add MDX components.\nAlthough it's simply located in page.tsx, which shouldn't be difficult to find, I think some kind of conventions may help, so I decided to add back mdx-components.tsx."
  }, {
    "heading": "mdx-componenttsx",
    "content": "I love to have fewer files, but considering create-fumadocs-app should also act as a starting point for beginners who may not be familiar with MDX, it's much more helpful to provide it by default."
  }, {
    "heading": "existing-projects",
    "content": "The convention is optional (only to make the learning curve smoother).\nFor existing users, you probably knew how to pass MDX components, and no further change is needed."
  }, {
    "heading": "existing-projects",
    "content": "But you can still make one:"
  }, {
    "heading": "existing-projects",
    "content": "And use it in your MDX component."
  }, {
    "heading": "deprecating-i18nprovider-",
    "content": "We now prefer a single <RootProvider /> for everything, replacing the need for <I18nProvider /> with a i18n prop."
  }, {
    "heading": "deprecating-i18nprovider-",
    "content": "This allows Root Provider to handle the hierarchy correctly without revealing too much complexity, for example, the correct order should be:"
  }, {
    "heading": "deprecating-i18nprovider-",
    "content": "Changing the hierarchy of different providers may result in problems since they actually rely on each other, now it is all integrated into <RootProvider />, including I18n configuration."
  }, {
    "heading": "deprecating-i18nprovider-",
    "content": "The new Internationalization guide requires Fumadocs 15.2.3 or above."
  }],
  "headings": [{
    "id": "mdx-componenttsx",
    "content": "mdx-component.tsx"
  }, {
    "id": "existing-projects",
    "content": "Existing Projects"
  }, {
    "id": "deprecating-i18nprovider-",
    "content": "Deprecating <I18nProvider />"
  }]
};
