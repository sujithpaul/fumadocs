export let structuredData = {
  "contents": [{
    "heading": "overview",
    "content": "Thanks to the flexible design, it is simple to implement access control with Fumadocs."
  }, {
    "heading": "loader-api",
    "content": "If you are using loader() API, you can create the loaders on-demand, and filter files from content source to restrict accessible content."
  }, {
    "heading": "loader-api",
    "content": "For example, this setup with Fumadocs MDX allows only MDX files with frontmatter permission: public to be shown."
  }, {
    "heading": "loader-api",
    "content": "import { docs } from 'fumadocs-mdx:collections/server';\nimport { loader, update } from 'fumadocs-core/source';\n\nconst filteredSource = update(docs.toFumadocsSource())\n  .files((files) =>\n    files.filter((file) => {\n      // keep meta files (e.g. `meta.json`)\n      if (file.type === 'meta') return true;\n\n      // access file data (type-safe)\n      return file.data.permission === 'public';\n    }),\n  )\n  .build();\n\nexport const source = loader(filteredSource, {\n  baseUrl: '/docs',\n});"
  }, {
    "heading": "loader-api",
    "content": "Or with more complicated setup, you may turn source into a factory function."
  }, {
    "heading": "loader-api",
    "content": "import { docs } from 'fumadocs-mdx:collections/server';\nimport { loader, update } from 'fumadocs-core/source';\n\n// uncached, it's better to cache it in-memory for real use case.\nexport function createSource(permission: 'public' | 'admin') {\n  const filteredSource = update(docs.toFumadocsSource())\n    .files((files) =>\n      files.filter((file) => {\n        if (file.type === 'meta') return true;\n\n        return file.data.permission === permission;\n      }),\n    )\n    .build();\n\n  return loader(filteredSource, {\n    baseUrl: '/docs',\n  });\n}"
  }, {
    "heading": "loader-api",
    "content": "// [!code --]\nimport { source } from '@/lib/source';\n// [!code ++:4]\nimport { createSource } from '@/lib/source';\n\nconst user = await getUser();\nconst source = createSource(user.permission);\n\nconst page = source.getPage(params.slugs);"
  }, {
    "heading": "advantages",
    "content": "What is special with this approach is that the access is limited at input level, rather than at rendering phase or build-time."
  }, {
    "heading": "advantages",
    "content": "This guarantees the protected content is filtered entirely, and without compromise on flexibility."
  }, {
    "heading": "custom-implementation",
    "content": "Without using Loader API, you can also implement your access control at framework-level (e.g. via Next.js routing & proxy)."
  }, {
    "heading": "custom-implementation",
    "content": "For example, to limit access to certain pages:"
  }, {
    "heading": "custom-implementation",
    "content": "import { notFound } from 'next/navigation';\nimport { source } from '@/lib/source';\n\nexport default async function Page({ params }) {\n  const { slugs } = await params;\n  const user = await getUser();\n  const page = source.getPage(slugs);\n\n  if (!page) notFound();\n  if (page.data.permission !== user.permission) notFound();\n\n  // render page...\n}"
  }, {
    "heading": "custom-implementation",
    "content": "Note that it is up to you to manage the page tree (sidebar items), search and other details."
  }, {
    "heading": "custom-implementation",
    "content": "This approach offers the best flexibility, but it doesn't rely on Fumadocs itself for access control, the setup may take longer and be more complicated."
  }, {
    "heading": "custom-implementation",
    "content": "It is better to consult the docs of your React.js framework when implementing."
  }],
  "headings": [{
    "id": "overview",
    "content": "Overview"
  }, {
    "id": "loader-api",
    "content": "Loader API"
  }, {
    "id": "advantages",
    "content": "Advantages"
  }, {
    "id": "custom-implementation",
    "content": "Custom Implementation"
